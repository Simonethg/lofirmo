# Copy to .env.local (never commit it). No keys are needed for the MVP.
# Network: "sepolia" (default) or "mainnet". Mainnet is read-only in this MVP.
NEXT_PUBLIC_CELO_NETWORK=sepolia
# Optional custom RPC URLs
CELO_SEPOLIA_RPC_URL=
CELO_MAINNET_RPC_URL=
# x402 paywall for /api/check (stub). "true" to require payment.
X402_ENABLED=false
X402_FACILITATOR_URL=https://x402.celo.org
X402_NETWORK=celo
X402_PRICE_USD=0.01
# Address that receives payments (public address only, never a private key)
X402_PAY_TO=
