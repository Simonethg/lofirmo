# Copy to .env.local (never commit it). No keys are needed for the MVP.
# Network: "sepolia" (default) or "mainnet". Mainnet is read-only in this MVP.
NEXT_PUBLIC_CELO_NETWORK=sepolia
# Optional custom RPC URLs
CELO_SEPOLIA_RPC_URL=
CELO_MAINNET_RPC_URL=
# Server-side mainnet sends (operator scripts only). Keep false for the web app.
MAINNET_SENDS_ENABLED=false
# x402 paywall for /api/check. "true" to require payment.
X402_ENABLED=false
# Mainnet: https://api.x402.celo.org + celo. Testnet: https://api.x402.sepolia.celo.org + celo-sepolia
X402_FACILITATOR_URL=https://api.x402.celo.org
X402_NETWORK=celo
# Facilitator key created on x402.celo.org (server secret, set it in the host's env, never here)
X402_API_KEY=
X402_PRICE_USD=0.01
# Address that receives payments (public address only, never a private key)
X402_PAY_TO=
